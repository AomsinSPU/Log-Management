{
  "name": "log-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx backend/src/migrate.ts",
    "seed": "tsx backend/src/seed.ts",
    "test": "tsx --test backend/tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-socket": "0.2.12",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
